# Local development/test only. Set .env owner-only permissions (chmod 600 .env).
# Staging/production: use a server-side SecretProvider, not a .env next to code.
# Fill these locally in .env. Never send the key in chat or commit it.
OPENAI_API_KEY=
# A model available to your API project that supports Responses + Structured Outputs.
KLEO_AI_MODEL=
KLEO_AI_TIMEOUT_MS=30000
KLEO_AI_MAX_OUTPUT_TOKENS=2000

# Yandex AI Studio. Model: yandexgpt/latest or full gpt://<folderId>/yandexgpt/latest.
YANDEX_API_KEY=
KLEO_YANDEX_FOLDER_ID=
KLEO_YANDEX_MODEL=
KLEO_YANDEX_TIMEOUT_MS=30000
KLEO_YANDEX_MAX_OUTPUT_TOKENS=2000

# Router defaults to openai; fallback disabled when blank.
KLEO_AI_PRIMARY_PROVIDER=
KLEO_AI_FALLBACK_PROVIDER=

# Auth/API foundation. Actual .env is NOT loaded automatically by API/CLI.
# Development is loopback-only; production requires explicit HTTPS origins and TLS files.
KLEO_API_ORIGIN=http://localhost:3001
KLEO_API_ALLOWED_ORIGINS=http://localhost:3000
KLEO_SESSION_SECONDS=28800
KLEO_API_TLS_KEY_FILE=
KLEO_API_TLS_CERT_FILE=
# Supply database login/password through server secret configuration, not tracked values.
PGHOST=
PGPORT=
PGDATABASE=
PGUSER=
PGPASSWORD=
# Public registration has no route; owner bootstrap accepts sensitive input only via stdin.
